# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
DATABASE_URL="your_atlas_db_url"

# Database path (legacy - not used with Atlas)
DB_PATH=./data



# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
# Base URL for the application (change in production)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000



# ===========================================
# THEMOVIEDB API CONFIGURATION
# ===========================================
# Get your API keys from: https://www.themoviedb.org/settings/api
TMDB_API_READ_ACCESS_TOKEN=your_tmdb_token
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_public_key
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
NEXT_READ_TMDB_API_KEY=your_tmdb_api_key



# ===========================================
# AUTHENTICATION CONFIGURATION
# ===========================================
# JWT Secret - Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secure_jwt_secret

# NextAuth Configuration
# NextAuth Secret - Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_next_auth_secret_key



# ===========================================
# OAUTH PROVIDERS
# ===========================================
# Google OAuth - Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_SECRET_ID=your_google_secret_id

# GitHub OAuth - Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_secret



# ===========================================
# EMAIL SERVICE CONFIGURATION
# ===========================================
# Gmail SMTP credentials
# For Gmail, use App Password (not regular password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=example@gmail.com
GMAIL_PASSWORD=your_google_app_password



# ===========================================
# NOTES
# ===========================================
# 1. Never commit this file with real values to version control
# 2. Copy this file to .env and fill in your actual credentials
# 3. For production, use environment variables in your hosting platform
# 4. Keep your secrets secure and rotate them regularly